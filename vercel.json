{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/sw.js", "headers": [{"key":"Cache-Control","value":"no-store, no-cache, must-revalidate"},{"key":"Service-Worker-Allowed","value":"/"}]},
    {"source": "/updates.json", "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source": "/index.html", "headers": [{"key":"Cache-Control","value":"no-cache"}]}
  ]
}